# Discord application
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Strongly recommended while setting up. Guild commands update immediately.
DISCORD_GUILD_ID=

# Channels
PALWORLD_CHAT_CHANNEL_ID=
PALWORLD_EVENTS_CHANNEL_ID=

# Optional role allowed to use admin/moderation commands.
# Members with Administrator or Manage Guild are also accepted.
PALWORLD_ADMIN_ROLE_ID=

# Palworld official REST API
# Keep this API private; normally use 127.0.0.1 or a trusted private network address.
PALWORLD_API_URL=http://127.0.0.1:8212/v1/api
PALWORLD_API_USERNAME=admin
PALWORLD_ADMIN_PASSWORD=
PALWORLD_REQUEST_TIMEOUT_MS=5000

# UE4SS -> bot bridge listener
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=3009
# Must match bridge_secret in UE4SS NexiumPalBridge/scripts/config.lua
BRIDGE_SECRET=

# Relay and polling
ALLOW_DISCORD_TO_GAME_CHAT=true
POLL_INTERVAL_MS=10000
REGISTER_COMMANDS_ON_START=true
